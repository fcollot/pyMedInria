function(pyMedInria_update_dependencies target_or_path)

    if(APPLE)
        if (TARGET ${target_or_path})
            add_custom_command(TARGET ${target_or_path} POST_BUILD
                COMMAND ${CMAKE_COMMAND}
                -D "TARGET_FILE:PATH=$<TARGET_FILE:${target_or_path}>"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pyMedInria_update_dependencies.cmake"
                VERBATIM
                )
        else()
            execute_process(
                COMMAND ${CMAKE_COMMAND}
                -D "TARGET_FILE:PATH=${target_or_path}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pyMedInria_update_dependencies.cmake"
                VERBATIM
                )
        endif()
    endif()

endfunction()

macro(pyMedInria_add_library target)

    add_library(${target} ${ARGN})

    pyMedInria_update_dependencies(${target})

endmacro()

macro(pyMedInria_add_executable target)

    add_executable(${target} ${ARGN})

    pyMedInria_update_dependencies(${target})

endmacro()
